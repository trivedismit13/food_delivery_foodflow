# ─── FoodFlow Docker Environment Template ────────────────────────────────────
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file with real secrets.

# ─── MySQL ───────────────────────────────────────────────────────────────────
# Database name (matches the schema used by the application)
DB_NAME=food_flow

# Application DB user credentials
DB_USERNAME=
DB_PASSWORD=

# Root password for MySQL container (only used at container init)
MYSQL_ROOT_PASSWORD=

# ─── Backend ─────────────────────────────────────────────────────────────────
# JWT signing secret — use a long random string (at least 64 characters)
JWT_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins the browser is allowed to reach the API from
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Frontend Build ───────────────────────────────────────────────────────────
# The URL the BROWSER uses to reach the backend API.
# For local Docker: http://localhost:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
